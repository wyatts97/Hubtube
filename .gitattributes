# Normalise line endings across buyer platforms.
* text=auto eol=lf
*.sh        text eol=lf
*.bat       text eol=crlf
*.png       binary
*.jpg       binary
*.webp      binary
*.woff2     binary
*.mp4       binary

# --------------------------------------------------------------------------
# Excluded from `git archive` — i.e. from the distributed buyer package.
# Development-only tooling and internal notes that should not ship.
# --------------------------------------------------------------------------
/.claude            export-ignore
/.vscode            export-ignore
/.github            export-ignore
/tests              export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/phpunit.xml        export-ignore
/dev.sh             export-ignore
